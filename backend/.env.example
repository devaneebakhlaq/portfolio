# MongoDB Setup:
# Option 1: Local MongoDB - mongodb://localhost:27017/portfolio_db
# Option 2: MongoDB Atlas - Get connection string from https://www.mongodb.com/cloud/atlas
# Railway provides PORT automatically. Keep trust proxy enabled in server.js.
PORT=5000
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/portfolio_db?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=admin123
FRONTEND_URL=http://localhost:5173,https://aneeb.surge.sh,https://aneebakhlaqdev.netlify.app
# Optional: email notifications for contact form
# Gmail SMTP (works, but may be less reliable on Railway)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
NOTIFY_EMAIL=your@email.com
# Production alternative: use Resend, SendGrid, or Mailgun if Gmail times out

